# ==============================================================================
# CYBERPRO ZERO-TRUST PLATFORM & AI CRM - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# NEVER commit your .env file, real API keys, tokens, or passwords to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
CYBERPRO_HOST=127.0.0.1           # Use 0.0.0.0 inside Docker / reverse proxy deployments
CYBERPRO_PORT=8000                # HTTP server port (default: 8000)
CYBERPRO_DB=./data/cyberpro.db    # SQLite database path (auto-initialized from data/schema.sql)
CYBERPRO_SESSION_HOURS=12         # Session token lifetime in hours
CYBERPRO_COOKIE_SECURE=0          # Set to 1 behind HTTPS in production
CYBERPRO_TRUST_PROXY=0            # Set to 1 only behind trusted Nginx / Cloudflare proxy

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE TURNSTILE HUMAN VERIFICATION
# ------------------------------------------------------------------------------
# Replace these official Cloudflare Always-Pass sandbox keys with real keys
# from https://dash.cloudflare.com/?to=/:account/turnstile in production.
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_ENABLED=1

# ------------------------------------------------------------------------------
# 3. OPTIONAL EXTERNAL AI PROVIDERS (GEMINI / OPENAI)
# ------------------------------------------------------------------------------
# Leave blank to run the built-in CYBERPRO Neural Inference Engine locally.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional Staff Account Bootstrap (useful on Vercel ephemeral /tmp deployments)
# CYBERPRO_ADMIN_EMAIL=admin@yourdomain.com
# CYBERPRO_ADMIN_PASSWORD=choose-strong-admin-password
# CYBERPRO_INSTRUCTOR_EMAIL=instructor@yourdomain.com
# CYBERPRO_INSTRUCTOR_PASSWORD=choose-strong-instructor-password

# ------------------------------------------------------------------------------
# 4. OPTIONAL TEST SUITE TARGET (ONLY NEEDED FOR TESTING A RUNNING SERVER)
# ------------------------------------------------------------------------------
# By default, unittest tests automatically spin up an isolated temporary server & DB.
# CYBERPRO_TEST_URL=http://127.0.0.1:8000
# CYBERPRO_TEST_ADMIN_EMAIL=admin@example.com
# CYBERPRO_TEST_ADMIN_PASS=replace-with-local-test-password
